# Supabase (local: valores impressos por `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor. Ignora RLS: nunca usar com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Segredo compartilhado entre o pg_cron (Vault: worker_secret) e /api/worker.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=

# F1: AI Gateway da Vercel
# AI_GATEWAY_API_KEY=
