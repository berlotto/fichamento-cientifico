# Supabase (local: valores impressos por `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor. Ignora RLS: nunca usar com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Segredo compartilhado entre o pg_cron (Vault: worker_secret) e /api/worker.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=

# F1: AI Gateway da Vercel. Na Vercel a autenticação é por OIDC (não precisa da chave);
# localmente, crie uma chave em vercel.com > AI Gateway > API Keys.
AI_GATEWAY_API_KEY=
# Modelo da extração (padrão: anthropic/claude-sonnet-5.5). O plano gratuito do
# Gateway só libera alguns modelos da OpenAI, como openai/gpt-5-mini.
# EXTRACT_MODEL=
